# Mermaid Studio — example configuration.
# Copy to .env.local and fill in what you need. Every variable is optional;
# the values below are the defaults the app falls back to.
# See README.md for the full table.

# Public site origin, used for canonical links, Open Graph URLs, robots.txt
# and sitemap.xml. Leave unset in local development (falls back to
# http://localhost:3000); set it to the deployed origin in production.
NEXT_PUBLIC_SITE_URL=

# ANTHROPIC_COMPATIBLE — any Anthropic-Messages-API endpoint works,
# including relays (e.g. https://api.minimax.cn/anthropic).
ANTHROPIC_COMPATIBLE_API_KEY=
ANTHROPIC_COMPATIBLE_BASE_URL=
ANTHROPIC_COMPATIBLE_MODEL=claude-haiku-4-5

# OPENAI_COMPATIBLE — used when no Anthropic-compatible key is set.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openrouter.ai/api/v1
OPENAI_COMPATIBLE_MODEL=anthropic/claude-3.5-haiku

# SQLite database file for saved conversations. Leave unset to use
# ./data/mermaid-studio.db. Point it at a persistent volume in production —
# the file lives on the local filesystem and does not survive an ephemeral
# deployment.
DATABASE_PATH=

# Auto-save delay in milliseconds for the title and the Mermaid source.
# 0 disables auto-save; unset defaults to 2000; anything below 500 is
# clamped to 500.
AUTOSAVE_INTERVAL_MS=

# Owner every conversation belongs to. The app is single-user today; the
# column exists so a multi-user build can filter rows per account.
DEFAULT_OWNER_ID=
