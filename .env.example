# Anthropic 兼容端点（默认 provider，必填其中一个）
# 任意实现了 Anthropic Messages API 的服务都适用，含 api.minimax.cn/anthropic 这类转发端点。
ANTHROPIC_COMPATIBLE_API_KEY=
ANTHROPIC_COMPATIBLE_BASE_URL=
ANTHROPIC_COMPATIBLE_MODEL=claude-haiku-4-5

# OpenAI 兼容端点配置（可选，ANTHROPIC_COMPATIBLE_API_KEY 未设置时启用）
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openrouter.ai/api/v1
OPENAI_COMPATIBLE_MODEL=anthropic/claude-3.5-haiku